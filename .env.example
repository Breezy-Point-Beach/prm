# ─────────────────────────────────────────────────────────────────────────────
# PRM — environment contract.
#
# If a variable is not in this file, it does not exist. Copy to .env.local for
# local development, or run `vercel env pull .env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Local development ───────────────────────────────────────────────────────
# Where the development FileStore writes published policies. Defaults to
# apps/web/.prm-store. Local dev needs NO other configuration: `pnpm dev` works
# from a fresh clone with this file copied to .env.local and nothing filled in.
#
# The FileStore is development-only. Vercel's filesystem is read-only outside an
# ephemeral /tmp, so production storage lands with the deployment PR.
PRM_STORE_DIR=""

# ─── Database — Neon (Vercel Marketplace) ────────────────────────────────────
# Pooled URL for request paths; direct (unpooled) URL for migrations.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/prm?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/prm?sslmode=require"

# ─── Public configuration (safe to expose in the client bundle) ──────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHORT_URL_BASE="http://localhost:3000/p"
NEXT_PUBLIC_LOG_ID="prm-log-dev"
# Public half of the transparency-log key. Clients verify signed tree heads with it.
NEXT_PUBLIC_LOG_PUBLIC_KEY=""

# ─── Transparency log signing — THE ONLY SERVER-HELD SIGNING KEY ─────────────
# Ed25519 private key, base64.
#
# BLAST RADIUS: compromise lets an attacker forge SIGNED TREE HEADS. It does NOT
# let anyone forge, alter, or repudiate any user-signed policy, authorization,
# key event, or ledger entry — those are signed by keys that never leave the
# user's device. Forged heads are detectable via consistency proofs, external
# RFC 3161 timestamps, and (from beta) third-party witnesses.
#
# Rotate quarterly. Publish every historical PUBLIC key at /.well-known/prm-log
# so previously issued tree heads remain verifiable after rotation.
LOG_SIGNING_KEY_B64=""

# ─── Timestamping ────────────────────────────────────────────────────────────
# Two independent authorities, so one operator's compromise or shutdown does not
# orphan the archive.
TSA_PRIMARY_URL="https://freetsa.org/tsr"
TSA_SECONDARY_URL="https://timestamp.digicert.com"
# Guards /api/cron/* — Vercel sends this as a bearer token.
CRON_SECRET=""

# ─── Object storage — Vercel Blob ────────────────────────────────────────────
# Stores encrypted vault backups and encrypted evidence artifacts. CIPHERTEXT
# ONLY: the decryption key is derived on the user's device and never uploaded.
BLOB_READ_WRITE_TOKEN=""

# ─── Rate limiting — Upstash Redis ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Optional (beta) ─────────────────────────────────────────────────────────
# Wallet-pass provider certificates. These sign CARDS, not policies: a forged
# card fails as soon as a verifier resolves the policy it points at.
APPLE_PASS_CERT_B64=""
APPLE_PASS_CERT_PASSWORD=""
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=""
# Outbound notices and publish notifications.
RESEND_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# NEVER ADD, IN ANY ENVIRONMENT:
#
#   a user signing key, master seed, next-rotation key, recovery key, vault key,
#   binding secret, identifier salt, raw identifier, or plaintext evidence.
#
# There is no legitimate server-side use for any of these. A pull request that
# introduces one is rejected on sight — see docs/01-identity-and-keys.md §8.
# ─────────────────────────────────────────────────────────────────────────────
