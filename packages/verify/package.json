{
  "name": "@prm/verify",
  "version": "0.1.0",
  "description": "Independent, offline-capable verification of PRM policies, key events, authorizations, ledgers, and proof bundles. Requires no PRM service, API, database, or network access.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:offline": "vitest run test/offline.test.ts"
  },
  "dependencies": {
    "@prm/crypto": "workspace:*",
    "@prm/schema": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
