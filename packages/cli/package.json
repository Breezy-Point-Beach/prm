{
  "name": "@rightsroot/prm-cli",
  "version": "0.1.1",
  "description": "Verify PRM policies, key events, ledgers and .prmproof bundles offline — without contacting RightsRoot or anyone else.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "prm": "dist/prm.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/prm.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js && pnpm bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs",
    "prepack": "pnpm bundle"
  },
  "devDependencies": {
    "@prm/crypto": "workspace:*",
    "@prm/notice": "workspace:*",
    "@prm/schema": "workspace:*",
    "@prm/verify": "workspace:*",
    "esbuild": "0.25.4",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Breezy-Point-Beach/prm.git",
    "directory": "packages/cli"
  },
  "homepage": "https://rightsroot.org/spec/prm",
  "keywords": [
    "prm",
    "rightsroot",
    "verify",
    "rfc3161",
    "merkle",
    "personal-data-policy"
  ]
}
