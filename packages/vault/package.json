{
  "name": "@prm/vault",
  "version": "0.1.0",
  "description": "Client-side key vault for PRM: BIP-39 mnemonic backup, Argon2id/WebAuthn-PRF wrapping, XChaCha20-Poly1305 encryption. Runs in the browser; secrets never reach a server.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ciphers": "1.2.0",
    "@noble/hashes": "1.6.1",
    "@prm/crypto": "workspace:*",
    "@prm/schema": "workspace:*",
    "@scure/base": "1.2.1",
    "@scure/bip39": "1.5.0"
  },
  "devDependencies": {
    "@prm/verify": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
