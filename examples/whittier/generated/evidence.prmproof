          "note": "An imminent threat to life, for the duration of that emergency only."
        },
        "basisAcknowledged": [
          "vital-interest"
        ]
      },
      {
        "category": "prm:retention",
        "decision": "conditional",
        "conditions": {
          "maxRetention": "PT0S",
          "recipients": [
