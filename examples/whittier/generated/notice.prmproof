  "artifacts": {
    "policy.json": "{\n  \"@context\": [\n    \"https://www.w3.org/ns/credentials/v2\",\n    \"https://rightsroot.org/spec/prm/ns/v1\"\n  ],\n  \"type\": [\n    \"VerifiableCredential\",\n    \"PersonalDataPolicy\"\n  ],\n  \"policyChainId\": \"urn:prm:chain:uEiDvRgzy0aV11g-h-BuMD9gbYTrA3EP7eKrFyeOeyn_VGw\",\n  \"version\": 1,\n  \"previousPolicyHash\": null,\n  \"issuer\": {\n    \"id\": \"prm:s2nfbcv7jr5kcf3yopfs5dlrqa\",\n    \"did\": \"did:key:z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH\",\n    \"keyEventLog\": \"https://rightsroot.com/u/user0001/kel.json\",\n    \"keyEventHash\": \"uEiCWmlCKv0x6oRd4c8sujXGAHMGIESmnmHdAh7hr4bFZcQ\"\n  },\n  \"effectiveDate\": \"2026-09-15T00:00:00Z\",\n  \"jurisdictions\": [\n    \"US-CA\",\n    \"US\"\n  ],\n  \"rules\": [\n    {\n      \"category\": \"prm:observation\",\n      \"decision\": \"allow\",\n      \"note\": \"I do not object to the lawful capture of my plate in a public place at the moment it occurs.\"\n    },\n    {\n      \"category\": \"prm:transactional\",\n      \"decision\": \"conditional\",\n      \"conditions\": {\n        \"maxRetention\": \"PT0S\",\n        \"purposes\": [\n          \"prm:hotlist-comparison\"\n        ],\n        \"jurisdictions\": [\n          \"US-CA\"\n        ],\n        \"note\": \"Immediate comparison against a lawfully constituted hotlist at the moment of capture. This is the use I authorize; it completes when the comparison completes.\"\n      }\n    },\n    {\n      \"category\": \"prm:law-enforcement\",\n      \"decision\": \"conditional\",\n      \"conditions\": {\n        \"requiresLegalProcess\": true,\n        \"requiresNotice\": true,\n        \"maxRetention\": \"P60D\",\n        \"purposes\": [\n          \"prm:active-investigation\"\n        ],\n        \"jurisdictions\": [\n          \"US-CA\"\n        ],\n        \"note\": \"Use tied to a valid, individualized investigative purpose, retained only for as long as that specific investigation requires.\"\n      },\n      \"basisAcknowledged\": [\n        \"court-order\",\n        \"statutory-override\"\n      ]\n    },\n    {\n      \"category\": \"prm:emergency\",\n      \"decision\": \"conditional\",\n      \"conditions\": {\n        \"requiresNotice\": true,\n        \"note\": \"An imminent threat to life, for the duration of that emergency only.\"\n      },\n      \"basisAcknowledged\": [\n        \"vital-interest\"\n      ]\n    },\n    {\n      \"category\": \"prm:retention\",\n      \"decision\": \"conditional\",\n      \"conditions\": {\n        \"maxRetention\": \"PT0S\",\n        \"recipients\": [\n          \"prm:none\"\n        ],\n        \"note\": \"A read that produced no hotlist match has served its purpose at the instant of comparison. I do not consent to its retention beyond that moment.\"\n      }\n    },\n    {\n      \"category\": \"prm:location-history\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to the storage of my vehicle observations as a time-series location history, and to historical search of such a record.\"\n    },\n    {\n      \"category\": \"prm:correlation\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to aggregating these reads with one another or correlating them with records held in other databases or systems.\"\n    },\n    {\n      \"category\": \"prm:profiling\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to the construction of any behavioral profile from where my vehicle has been.\"\n    },\n    {\n      \"category\": \"prm:inference\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to derived movement inference: pattern-of-life analysis, travel prediction, anomaly or \\\"unusual movement\\\" scoring, and association analysis based on co-location.\"\n    },\n    {\n      \"category\": \"prm:third-party-sharing\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to disclosure to other agencies and to participation in any regional, statewide, federal, or commercial sharing network.\"\n    },\n    {\n      \"category\": \"prm:sale\",\n      \"decision\": \"deny\",\n      \"note\": \"I do not consent to the sale of these records.\"\n    },\n    {\n      \"category\": \"prm:commercialization\",\n      \"decision\": \"deny\",\n      \"note\": \"I do not consent to commercial exploitation of these records by an agency or its vendor.\"\n    },\n    {\n      \"category\": \"prm:advertising\",\n      \"decision\": \"deny\"\n    },\n    {\n      \"category\": \"prm:ai-training\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to the inclusion of these records in the training, fine-tuning, or evaluation of any machine learning model, including vendor product development.\"\n    },\n    {\n      \"category\": \"prm:biometric\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to biometric processing of imagery of vehicle occupants.\"\n    },\n    {\n      \"category\": \"prm:deletion\",\n      \"decision\": \"conditional\",\n      \"conditions\": {\n        \"maxRetention\": \"PT0S\",\n        \"requiresNotice\": false,\n        \"note\": \"I request deletion of non-hit reads immediately, and of investigation-related reads on closure of the specific matter that justified retaining them.\"\n      }\n    }\n  ],\n  \"identifierCommitments\": [\n    {\n      \"namespace\": \"us-license-plate\",\n      \"commitment\": \"uEiCBpKuuDgLZKdS3dJS0aoXC2h9lZeLGm-eEJSXZ8S6oqQ\"\n    },\n    {\n      \"namespace\": \"email\",\n      \"commitment\": \"uEiBCY7ckGV2ZrV8ehuUP0hHzeya5b3uQUwiC1MHTF387qw\"\n    }\n  ],\n  \"requests\": {\n    \"deletionOnPurposeCompletion\": true,\n    \"doNotSellOrShare\": true,\n    \"globalPrivacyControl\": true\n  },\n  \"humanReadable\": {\n    \"mediaType\": \"text/markdown\",\n    \"language\": \"en\",\n    \"text\": \"# Personal Data Policy — Automated License Plate Reader Records\\n\\n## What I authorize\\n\\nI do not object to the lawful photographing of my vehicle's license plate in a public place, nor to\\nthe immediate comparison of that plate against a lawfully constituted hotlist at the moment of\\ncapture. I understand that is what the system is for, and I am not asking City of Whittier Police Department to stop operating\\nit.\\n\\nWhere there is a valid, individualized investigative purpose supported by appropriate legal process,\\nor a genuine emergency involving an imminent threat to life, I do not object to the use of a read\\nabout my vehicle for the duration of that specific matter.\\n\\n## What I object to and do not consent to\\n\\nEverything that happens after the moment of comparison is a separate act, and I address it separately.\\nI object to, and do not consent to:\\n\\n- retention of a read that produced no hotlist match, beyond the instant of comparison;\\n- storage of my vehicle observations as a historical location record, and search of such a record;\\n- aggregation of these reads with one another to reconstruct my movements over time;\\n- correlation of these reads with records held in other databases or systems;\\n- disclosure to other agencies, or to any regional, statewide, federal, or commercial sharing network;\\n- behavioral profiling, and derived movement inference such as pattern-of-life analysis, travel\\n  prediction, or \\\"unusual movement\\\" scoring;\\n- sale, commercial exploitation, or advertising use;\\n- inclusion in the training, fine-tuning, or evaluation of any machine learning model, including\\n  vendor product development;\\n- biometric processing of imagery of vehicle occupants.\\n\\n## What this document is, and is not\\n\\nThis is a record of my instructions and the date on which I gave them. It is signed, so that a third\\nparty can confirm exactly what it says and that it was issued under my key. The date is my own\\nstatement; independent evidence of when this document existed, where it has been obtained,\\naccompanies it separately.\\n\\nIt does not purport to create rights that do not already exist, and I make no claim here about which\\nof these restrictions California law obliges you to honour. Where a court order or a specific\\nstatutory mandate requires something I have objected to, I acknowledge that it governs, and I ask only\\nfor written notice and for retention limited to what that basis actually requires.\\n\\n## What I am asking of you\\n\\nPlease confirm receipt, and tell me which of these restrictions your systems can and cannot honour,\\nand why. A partial answer with a citation is more useful to me than no answer.\\n\\nI would also like to know what reads you currently hold that are associated with my vehicle, how long\\nyou retain them, and with whom they have been shared.\"\n  },\n  \"distribution\": {\n    \"canonicalUrl\": \"https://rightsroot.com/u/user0001\",\n    \"machineUrl\": \"https://rightsroot.com/u/user0001/policy.json\",\n    \"shortUrl\": \"https://rightsroot.com/p/user0001\",\n    \"statusList\": \"https://rightsroot.com/status/1\"\n  },\n  \"id\": \"urn:prm:policy:uEiCCVYqo5goptwm4lS1RN_8WgOwJ5A8un4JTasreIyS9JA\",\n  \"proof\": {\n    \"type\": \"DataIntegrityProof\",\n    \"cryptosuite\": \"eddsa-jcs-2022\",\n    \"created\": \"2026-09-15T17:00:00Z\",\n    \"verificationMethod\": \"did:key:z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH#z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH\",\n    \"proofPurpose\": \"assertionMethod\",\n    \"proofValue\": \"ztzZerzsxiUpKZaisQLM2fcW1qJ2omcDU24tuaRiF3KaCRaeJqdjHGoqzGchvAQUYSoYHytTZFDGmCXzo8ugZAA9\"\n  }\n}",
    "key-events/kel.json": "[\n  {\n    \"type\": \"prm/KeyEvent/v1\",\n    \"eventType\": \"genesis\",\n    \"sequence\": 0,\n    \"previousEventHash\": null,\n    \"created\": \"2026-09-15T17:00:00Z\",\n    \"keys\": [\n      {\n        \"id\": \"#k0\",\n        \"alg\": \"Ed25519\",\n        \"publicKeyMultibase\": \"z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH\",\n        \"use\": [\n          \"assertion\",\n          \"authentication\"\n        ],\n        \"device\": \"user-device\"\n      }\n    ],\n    \"nextKeyDigests\": [\n      \"uEiBhJC8wNBCwVO9152-kvVzC3exItJg_V9LcYJ3OMNGTrQ\"\n    ],\n    \"recoveryKeyDigests\": [\n      \"uEiBKY6QQmWfp7G8AK7peUI8z6xrmmwoTwxMf-Wm-lE4_Qg\"\n    ],\n    \"threshold\": 1,\n    \"services\": [\n      {\n        \"type\": \"PRMPublisher\",\n        \"endpoint\": \"https://rightsroot.com/u/user0001\"\n      }\n    ],\n    \"proof\": [\n      {\n        \"type\": \"DataIntegrityProof\",\n        \"cryptosuite\": \"eddsa-jcs-2022\",\n        \"created\": \"2026-09-15T17:00:00Z\",\n        \"verificationMethod\": \"did:key:z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH#z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH\",\n        \"proofPurpose\": \"assertionMethod\",\n        \"proofValue\": \"z3CWvYnrGpMhHhiVkp3FaEHCLkgj9y3WyfqPohT7sd8dp3whHHpWaZP2akdX5QW4ek9UPm3Z43bJUjPm2LPUBqDs8\"\n      }\n    ]\n  }\n]",
    "notice.json": "{\n  \"@context\": [\n    \"https://www.w3.org/ns/credentials/v2\",\n    \"https://rightsroot.org/spec/prm/ns/v1\"\n  ],\n  \"type\": [\n    \"VerifiableCredential\",\n    \"PRMNotice\"\n  ],\n  \"policyChainId\": \"urn:prm:chain:uEiDvRgzy0aV11g-h-BuMD9gbYTrA3EP7eKrFyeOeyn_VGw\",\n  \"policyDigest\": \"uEiCCVYqo5goptwm4lS1RN_8WgOwJ5A8un4JTasreIyS9JA\",\n  \"policyByteDigest\": \"uEiCKt6706NwzOf5Som7k6H20_z_DEh6Gwq8rH-IhM8yEeQ\",\n  \"policyVersion\": 1,\n  \"policyUrl\": \"https://rightsroot.com/u/user0001\",\n  \"issuer\": {\n    \"id\": \"prm:s2nfbcv7jr5kcf3yopfs5dlrqa\",\n    \"did\": \"did:key:z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH\",\n    \"keyEventLog\": \"https://rightsroot.com/u/user0001/kel.json\",\n    \"keyEventHash\": \"uEiCWmlCKv0x6oRd4c8sujXGAHMGIESmnmHdAh7hr4bFZcQ\"\n  },\n  \"recipient\": {\n    \"name\": \"City of Whittier Police Department\",\n    \"type\": \"law-enforcement\",\n    \"department\": \"Records Division\",\n    \"domain\": \"whittierpd.org\",\n    \"contact\": \"records@whittierpd.org\",\n    \"postalAddress\": \"13200 Penn St\\nWhittier, CA 90602\",\n    \"jurisdiction\": \"US-CA\"\n  },\n  \"purpose\": \"To place my standing personal data policy on record with the recipient.\",\n  \"issued\": \"2026-09-16T16:00:00Z\",\n  \"matchingIdentifiers\": [\n    {\n      \"namespace\": \"us-license-plate\",\n      \"value\": \"US-CA-0EXAMPLE\",\n      \"salt\": \"qMNe3DAjqBbp0fBQzvWTJw\"\n    }\n  ],\n  \"requestedTreatment\": \"Please associate this Personal Rights Management policy with records reasonably identifiable as relating to me and honor the stated instructions and objections to the extent permitted by applicable law, policy, contract, and technical capability.\",\n  \"legalEffect\": \"Personal Rights Management records my standing instructions, authorizations, and objections concerning downstream processing of personal information associated with me. This notice does not independently create legal rights or obligations where none otherwise exist, and nothing in it overrides a valid court order, statutory mandate, or other controlling legal authority.\\n\\nIf any portion of this policy cannot or will not be honored, this notice should still be treated as a record of my express position and non-consent regarding those downstream uses.\",\n  \"proof\": {\n    \"type\": \"DataIntegrityProof\",\n    \"cryptosuite\": \"eddsa-jcs-2022\",\n    \"created\": \"2026-09-16T16:00:00Z\",\n    \"verificationMethod\": \"did:key:z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH#z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH\",\n    \"proofPurpose\": \"assertionMethod\",\n    \"proofValue\": \"zyd8ikNvfNrXgHEhhmehd635XtLTokRLRQC82mTmccJyCBCQGEhdx1dPAFCxmEtZkGbpaAYpUe73bwuaBJqr8R6e\"\n  },\n  \"id\": \"urn:prm:notice:uEiC5IVcL4rLIEItGi5JPCBeTyfp__1e7h9yL3Z_vJO3tRg\"\n}",
    "policy-chain/v1.json": "{\n  \"@context\": [\n    \"https://www.w3.org/ns/credentials/v2\",\n    \"https://rightsroot.org/spec/prm/ns/v1\"\n  ],\n  \"type\": [\n    \"VerifiableCredential\",\n    \"PersonalDataPolicy\"\n  ],\n  \"policyChainId\": \"urn:prm:chain:uEiDvRgzy0aV11g-h-BuMD9gbYTrA3EP7eKrFyeOeyn_VGw\",\n  \"version\": 1,\n  \"previousPolicyHash\": null,\n  \"issuer\": {\n    \"id\": \"prm:s2nfbcv7jr5kcf3yopfs5dlrqa\",\n    \"did\": \"did:key:z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH\",\n    \"keyEventLog\": \"https://rightsroot.com/u/user0001/kel.json\",\n    \"keyEventHash\": \"uEiCWmlCKv0x6oRd4c8sujXGAHMGIESmnmHdAh7hr4bFZcQ\"\n  },\n  \"effectiveDate\": \"2026-09-15T00:00:00Z\",\n  \"jurisdictions\": [\n    \"US-CA\",\n    \"US\"\n  ],\n  \"rules\": [\n    {\n      \"category\": \"prm:observation\",\n      \"decision\": \"allow\",\n      \"note\": \"I do not object to the lawful capture of my plate in a public place at the moment it occurs.\"\n    },\n    {\n      \"category\": \"prm:transactional\",\n      \"decision\": \"conditional\",\n      \"conditions\": {\n        \"maxRetention\": \"PT0S\",\n        \"purposes\": [\n          \"prm:hotlist-comparison\"\n        ],\n        \"jurisdictions\": [\n          \"US-CA\"\n        ],\n        \"note\": \"Immediate comparison against a lawfully constituted hotlist at the moment of capture. This is the use I authorize; it completes when the comparison completes.\"\n      }\n    },\n    {\n      \"category\": \"prm:law-enforcement\",\n      \"decision\": \"conditional\",\n      \"conditions\": {\n        \"requiresLegalProcess\": true,\n        \"requiresNotice\": true,\n        \"maxRetention\": \"P60D\",\n        \"purposes\": [\n          \"prm:active-investigation\"\n        ],\n        \"jurisdictions\": [\n          \"US-CA\"\n        ],\n        \"note\": \"Use tied to a valid, individualized investigative purpose, retained only for as long as that specific investigation requires.\"\n      },\n      \"basisAcknowledged\": [\n        \"court-order\",\n        \"statutory-override\"\n      ]\n    },\n    {\n      \"category\": \"prm:emergency\",\n      \"decision\": \"conditional\",\n      \"conditions\": {\n        \"requiresNotice\": true,\n        \"note\": \"An imminent threat to life, for the duration of that emergency only.\"\n      },\n      \"basisAcknowledged\": [\n        \"vital-interest\"\n      ]\n    },\n    {\n      \"category\": \"prm:retention\",\n      \"decision\": \"conditional\",\n      \"conditions\": {\n        \"maxRetention\": \"PT0S\",\n        \"recipients\": [\n          \"prm:none\"\n        ],\n        \"note\": \"A read that produced no hotlist match has served its purpose at the instant of comparison. I do not consent to its retention beyond that moment.\"\n      }\n    },\n    {\n      \"category\": \"prm:location-history\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to the storage of my vehicle observations as a time-series location history, and to historical search of such a record.\"\n    },\n    {\n      \"category\": \"prm:correlation\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to aggregating these reads with one another or correlating them with records held in other databases or systems.\"\n    },\n    {\n      \"category\": \"prm:profiling\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to the construction of any behavioral profile from where my vehicle has been.\"\n    },\n    {\n      \"category\": \"prm:inference\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to derived movement inference: pattern-of-life analysis, travel prediction, anomaly or \\\"unusual movement\\\" scoring, and association analysis based on co-location.\"\n    },\n    {\n      \"category\": \"prm:third-party-sharing\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to disclosure to other agencies and to participation in any regional, statewide, federal, or commercial sharing network.\"\n    },\n    {\n      \"category\": \"prm:sale\",\n      \"decision\": \"deny\",\n      \"note\": \"I do not consent to the sale of these records.\"\n    },\n    {\n      \"category\": \"prm:commercialization\",\n      \"decision\": \"deny\",\n      \"note\": \"I do not consent to commercial exploitation of these records by an agency or its vendor.\"\n    },\n    {\n      \"category\": \"prm:advertising\",\n      \"decision\": \"deny\"\n    },\n    {\n      \"category\": \"prm:ai-training\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to the inclusion of these records in the training, fine-tuning, or evaluation of any machine learning model, including vendor product development.\"\n    },\n    {\n      \"category\": \"prm:biometric\",\n      \"decision\": \"deny\",\n      \"note\": \"I object to biometric processing of imagery of vehicle occupants.\"\n    },\n    {\n      \"category\": \"prm:deletion\",\n      \"decision\": \"conditional\",\n      \"conditions\": {\n        \"maxRetention\": \"PT0S\",\n        \"requiresNotice\": false,\n        \"note\": \"I request deletion of non-hit reads immediately, and of investigation-related reads on closure of the specific matter that justified retaining them.\"\n      }\n    }\n  ],\n  \"identifierCommitments\": [\n    {\n      \"namespace\": \"us-license-plate\",\n      \"commitment\": \"uEiCBpKuuDgLZKdS3dJS0aoXC2h9lZeLGm-eEJSXZ8S6oqQ\"\n    },\n    {\n      \"namespace\": \"email\",\n      \"commitment\": \"uEiBCY7ckGV2ZrV8ehuUP0hHzeya5b3uQUwiC1MHTF387qw\"\n    }\n  ],\n  \"requests\": {\n    \"deletionOnPurposeCompletion\": true,\n    \"doNotSellOrShare\": true,\n    \"globalPrivacyControl\": true\n  },\n  \"humanReadable\": {\n    \"mediaType\": \"text/markdown\",\n    \"language\": \"en\",\n    \"text\": \"# Personal Data Policy — Automated License Plate Reader Records\\n\\n## What I authorize\\n\\nI do not object to the lawful photographing of my vehicle's license plate in a public place, nor to\\nthe immediate comparison of that plate against a lawfully constituted hotlist at the moment of\\ncapture. I understand that is what the system is for, and I am not asking City of Whittier Police Department to stop operating\\nit.\\n\\nWhere there is a valid, individualized investigative purpose supported by appropriate legal process,\\nor a genuine emergency involving an imminent threat to life, I do not object to the use of a read\\nabout my vehicle for the duration of that specific matter.\\n\\n## What I object to and do not consent to\\n\\nEverything that happens after the moment of comparison is a separate act, and I address it separately.\\nI object to, and do not consent to:\\n\\n- retention of a read that produced no hotlist match, beyond the instant of comparison;\\n- storage of my vehicle observations as a historical location record, and search of such a record;\\n- aggregation of these reads with one another to reconstruct my movements over time;\\n- correlation of these reads with records held in other databases or systems;\\n- disclosure to other agencies, or to any regional, statewide, federal, or commercial sharing network;\\n- behavioral profiling, and derived movement inference such as pattern-of-life analysis, travel\\n  prediction, or \\\"unusual movement\\\" scoring;\\n- sale, commercial exploitation, or advertising use;\\n- inclusion in the training, fine-tuning, or evaluation of any machine learning model, including\\n  vendor product development;\\n- biometric processing of imagery of vehicle occupants.\\n\\n## What this document is, and is not\\n\\nThis is a record of my instructions and the date on which I gave them. It is signed, so that a third\\nparty can confirm exactly what it says and that it was issued under my key. The date is my own\\nstatement; independent evidence of when this document existed, where it has been obtained,\\naccompanies it separately.\\n\\nIt does not purport to create rights that do not already exist, and I make no claim here about which\\nof these restrictions California law obliges you to honour. Where a court order or a specific\\nstatutory mandate requires something I have objected to, I acknowledge that it governs, and I ask only\\nfor written notice and for retention limited to what that basis actually requires.\\n\\n## What I am asking of you\\n\\nPlease confirm receipt, and tell me which of these restrictions your systems can and cannot honour,\\nand why. A partial answer with a citation is more useful to me than no answer.\\n\\nI would also like to know what reads you currently hold that are associated with my vehicle, how long\\nyou retain them, and with whom they have been shared.\"\n  },\n  \"distribution\": {\n    \"canonicalUrl\": \"https://rightsroot.com/u/user0001\",\n    \"machineUrl\": \"https://rightsroot.com/u/user0001/policy.json\",\n    \"shortUrl\": \"https://rightsroot.com/p/user0001\",\n    \"statusList\": \"https://rightsroot.com/status/1\"\n  },\n  \"id\": \"urn:prm:policy:uEiCCVYqo5goptwm4lS1RN_8WgOwJ5A8un4JTasreIyS9JA\",\n  \"proof\": {\n    \"type\": \"DataIntegrityProof\",\n    \"cryptosuite\": \"eddsa-jcs-2022\",\n    \"created\": \"2026-09-15T17:00:00Z\",\n    \"verificationMethod\": \"did:key:z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH#z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH\",\n    \"proofPurpose\": \"assertionMethod\",\n    \"proofValue\": \"ztzZerzsxiUpKZaisQLM2fcW1qJ2omcDU24tuaRiF3KaCRaeJqdjHGoqzGchvAQUYSoYHytTZFDGmCXzo8ugZAA9\"\n  }\n}",
    "log/ledger.json": "[\n  {\n    \"type\": \"prm/LedgerEntry/v1\",\n    \"accountId\": \"prm:s2nfbcv7jr5kcf3yopfs5dlrqa\",\n    \"sequence\": 0,\n    \"previousEntryHash\": null,\n    \"recorded\": \"2026-09-15T17:00:00Z\",\n    \"entryType\": \"key.event\",\n    \"subjectHash\": \"uEiCWmlCKv0x6oRd4c8sujXGAHMGIESmnmHdAh7hr4bFZcQ\",\n    \"proof\": {\n      \"type\": \"DataIntegrityProof\",\n      \"cryptosuite\": \"eddsa-jcs-2022\",\n      \"created\": \"2026-09-15T17:00:00Z\",\n      \"verificationMethod\": \"did:key:z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH#z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH\",\n      \"proofPurpose\": \"assertionMethod\",\n      \"proofValue\": \"z43ZRUvcks2uqywsiX9dDDhU2um32fiUP18q99YhzwgfBMj3v7kdBUiYi6jjeJiPL1eBnj1qisB2MYde2QfBaAqep\"\n    },\n    \"logInclusion\": {\n      \"logId\": \"prm-log-example\",\n      \"leafIndex\": 0,\n      \"treeSize\": 5,\n      \"rootHash\": \"uEiDjVe5V7gOe3b3tnLBpMbV714jR6CiztaTFxqJJJkWuxw\",\n      \"inclusionProof\": [\n        \"uEiAITOKq0FWpxtPtHg8sEfwj5zX1PNKk_5T2col0gWDNYQ\",\n        \"uEiCURvcoMGl5vDaqYr0RR7j7mU3wlLabOMjoUeDvv_Xr-g\",\n        \"uEiANlHN27yyP4Axl_4-5DCKtkFpxiMGzavAA8ybJOxLRTg\"\n      ]\n    }\n  },\n  {\n    \"type\": \"prm/LedgerEntry/v1\",\n    \"accountId\": \"prm:s2nfbcv7jr5kcf3yopfs5dlrqa\",\n    \"sequence\": 1,\n    \"previousEntryHash\": \"uEiCOt_OnN2EhSgAEcSGXkD53P2QRUMVLX3CadsVFGMWZJQ\",\n    \"recorded\": \"2026-09-15T17:00:00Z\",\n    \"entryType\": \"policy.published\",\n    \"subjectHash\": \"uEiCCVYqo5goptwm4lS1RN_8WgOwJ5A8un4JTasreIyS9JA\",\n    \"proof\": {\n      \"type\": \"DataIntegrityProof\",\n      \"cryptosuite\": \"eddsa-jcs-2022\",\n      \"created\": \"2026-09-15T17:00:00Z\",\n      \"verificationMethod\": \"did:key:z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH#z6MkfCwPTWq3SKbw4AVj7j8t8oFBiFp6CvZiTnXAw24nVkLH\",\n      \"proofPurpose\": \"assertionMethod\",\n      \"proofValue\": \"z2LrfsTqkHAg1ijobpdMFqC4VodpqDvfSPsYKoDEDve1bXxNojV